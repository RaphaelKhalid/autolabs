# Public URL of the deployed Cloudflare orchestration worker.
NEXT_PUBLIC_ORCHESTRATOR_URL=
# Server-only secret used to proxy owner start/stop actions. Never prefix with NEXT_PUBLIC_.
AUTOLABS_ADMIN_TOKEN=
# Worker-only. Configure with `wrangler secret put`; never store here.
OPENAI_API_KEY=
# Optional separate owner key for the bounded Experiment 3A queue.
AUTOLABS_3A_START_TOKEN=
# Server-only bearer token used to call the Worker 3A endpoint.
PERSONA_3A_WORKER_TOKEN=
# Optional server-only worker URL override; otherwise NEXT_PUBLIC_ORCHESTRATOR_URL is used.
ORCHESTRATOR_URL=

# This file is safe to commit because values are intentionally blank.
# Never place credentials in NEXT_PUBLIC_* variables. Self-hosted runner
# settings and its owner token belong in the ignored .env.selfhost.local.
